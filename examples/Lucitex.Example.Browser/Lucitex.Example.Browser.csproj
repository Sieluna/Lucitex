<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-browser</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Lucitex.Example.Browser</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <WasmEnableSIMD>true</WasmEnableSIMD>
    <PublishTrimmed>false</PublishTrimmed>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Lucitex.Core\Lucitex.Core.csproj" />
    <ProjectReference Include="..\..\src\Lucitex.Conversion\Lucitex.Conversion.csproj" />
    <ProjectReference Include="..\..\src\Lucitex.Dds\Lucitex.Dds.csproj" />
    <ProjectReference Include="..\..\src\Lucitex.Exr\Lucitex.Exr.csproj" />
    <ProjectReference Include="..\..\src\Lucitex.Hdr\Lucitex.Hdr.csproj" />
    <ProjectReference Include="..\..\src\Lucitex.Jpeg\Lucitex.Jpeg.csproj" />
    <ProjectReference Include="..\..\src\Lucitex.Ktx2\Lucitex.Ktx2.csproj" />
    <ProjectReference Include="..\..\src\Lucitex.Png\Lucitex.Png.csproj" />
    <ProjectReference Include="..\..\src\Lucitex.Webp\Lucitex.Webp.csproj" />
  </ItemGroup>

</Project>
