<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <Optimize>true</Optimize>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <NoWarn>$(NoWarn);CA1822</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Lucitex.Compression\Lucitex.Compression.csproj" />
    <ProjectReference Include="..\..\src\Lucitex.Conversion\Lucitex.Conversion.csproj" />
    <ProjectReference Include="..\..\src\Lucitex.Core\Lucitex.Core.csproj" />
    <ProjectReference Include="..\..\src\Lucitex.Dds\Lucitex.Dds.csproj" />
    <ProjectReference Include="..\..\src\Lucitex.Exr\Lucitex.Exr.csproj" />
    <ProjectReference Include="..\..\src\Lucitex.Hdr\Lucitex.Hdr.csproj" />
    <ProjectReference Include="..\..\src\Lucitex.Ktx2\Lucitex.Ktx2.csproj" />
    <ProjectReference Include="..\..\src\Lucitex.Png\Lucitex.Png.csproj" />
  </ItemGroup>

</Project>
